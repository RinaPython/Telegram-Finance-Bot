# ============================================================
# TELEGRAM FINANCE BOT - ENVIRONMENT VARIABLES
# ============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang benar
# ============================================================

# ============================================================
# TELEGRAM BOT CONFIGURATION
# ============================================================
# Dapatkan dari @BotFather di Telegram
# Format: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_TOKEN=

# ============================================================
# GEMINI AI CONFIGURATION
# ============================================================
# Dapatkan dari Google AI Studio: https://aistudio.google.com/apikey
# Format: AIzaSyABCdefGHIjklMNOpqrsTUVwxyz
GEMINI_API_KEY=

# ============================================================
# AUTHORIZATION
# ============================================================
# Telegram User ID Anda (dapatkan dari @userinfobot)
# Format: 123456789 (angka saja)
AUTHORIZED_USER_ID=

# ============================================================
# GOOGLE SHEETS CONFIGURATION
# ============================================================
# Spreadsheet ID dari URL Google Sheets
# Contoh: https://docs.google.com/spreadsheets/d/1ABCdefGHIjklMNOpqrsTUVwxyz/edit
# Ambil bagian: 1ABCdefGHIjklMNOpqrsTUVwxyz
SPREADSHEET_ID=

# Google Service Account Credentials (JSON format, HARUS SATU BARIS)
# Cara mendapatkan:
#   1. Buat Service Account di Google Cloud Console
#   2. Generate JSON key
#   3. Baca file JSON dan ubah menjadi satu baris tanpa spasi
#   4. Contoh: {"type":"service_account","project_id":"..."}
#   PERHATIAN: Jangan gunakan line break, semua dalam satu baris!
GOOGLE_SHEETS_CREDENTIALS_JSON=

# ============================================================
# BOT SETTINGS
# ============================================================
# Hapus pesan transaksi otomatis setelah beberapa detik (true/false)
DELETE_MESSAGES=true

# Jumlah transaksi per halaman di riwayat
HISTORY_PAGE_SIZE=5

# Timezone untuk timestamp
TZ=Asia/Jakarta

# Level logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
