# ============================================================
# TELEGRAM FINANCE BOT - ENVIRONMENT VARIABLES
# ============================================================
# WAJIB: Bot TIDAK akan jalan tanpa ini
# ============================================================

# Telegram Bot Token (dari @BotFather)
TELEGRAM_TOKEN=

# Telegram User ID (dari @userinfobot)
AUTHORIZED_USER_ID=

# Google Gemini API Key (dari AI Studio)
GEMINI_API_KEY=

# ============================================================
# OPSIONAL: Fitur tambahan
# ============================================================

# Google Sheets Spreadsheet ID
SPREADSHEET_ID=

# Google Service Account Credentials (JSON satu baris)
GOOGLE_SHEETS_CREDENTIALS_JSON=

# Hapus pesan otomatis (true/false)
DELETE_MESSAGES=true

# Jumlah transaksi per halaman
HISTORY_PAGE_SIZE=5

# Timezone
TZ=Asia/Jakarta

# Level logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
